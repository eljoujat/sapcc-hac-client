# SAP Commerce Cloud HAC credentials
# Copy this file to .env and fill in your values

# HAC base URL (without trailing slash)
HAC_URL=https://backoffice.your-env.commerce.ondemand.com

# HAC credentials
HAC_USERNAME=admin
HAC_PASSWORD=your_password

# Optional: ignore SSL certificate errors (useful for dev/staging)
# HAC_IGNORE_SSL=true

# Optional: request timeout in milliseconds (default: 30000)
# HAC_TIMEOUT=30000
